# Copy to .env and fill in. Never commit real secrets.
NODE_ENV=development
PORT=3000

DATABASE_URL="postgresql://siragu:CHANGE_ME@localhost:5432/siragu_trace?schema=public"

# Generate with: openssl rand -base64 48
JWT_SECRET=
SESSION_SECRET=

# Comma-separated list of allowed browser origins (WS7 will enforce this in main.ts)
CORS_ORIGINS=http://localhost:5173

# Stable public domain encoded into printed QR codes: {PUBLIC_BASE_URL}/v/{token} (WS3)
PUBLIC_BASE_URL=http://localhost:5173
