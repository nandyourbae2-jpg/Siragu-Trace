generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  OWNER
  OPERATOR
  QA
  BUYER
  CONSUMER
}

/// Lot lifecycle state machine.
/// Valid transitions (§50):
///   DRAFT → RECEIVED → IN_PROCESS → READY → RELEASED → CLOSED
///   Any → HOLD (pause) | BLOCKED (critical issue)
///   HOLD → IN_PROCESS | BLOCKED | CLOSED
///   BLOCKED → CLOSED (manual override by OWNER)
enum LotStatus {
  DRAFT
  RECEIVED
  IN_PROCESS
  READY
  RELEASED
  HOLD
  BLOCKED
  CLOSED
}

/// Indicates how a lot was produced (§42).
enum LotType {
  RECEIVED        // Raw material received from external supplier
  MIX_OUTPUT      // Produced by a mixing operation (many inputs → 1 output)
  SPLIT_OUTPUT    // Produced by splitting a parent lot (1 input → many outputs)
  PROCESS_OUTPUT  // Produced by a general transformation process
  REWORK_OUTPUT   // Produced by rework of a rejected lot
  PACK_OUTPUT     // Final packaged unit
}

/// How two lots are related (§43).
enum RelationType {
  TRANSFORMED_TO  // Lot A was transformed into Lot B (general process)
  MIXED_INTO      // Lot A (source) was mixed into Lot B (mix output)
  SPLIT_FROM      // Lot B (output) was split from Lot A (parent)
  REWORKED_FROM   // Lot B (output) was reworked from Lot A (rejected)
  PACKED_FROM     // Lot B (pack) was packed from Lot A (ready lot)
}

/// Process event types (§13, §44).
enum ProcessEventType {
  DRYING
  SIEVING
  MIXING
  REWORK
  PACKING_PREP
  RECEIVING       // Initial lot ingestion from supplier
  CUSTOM
}

/// Mass balance validation status (§15).
enum MassBalanceStatus {
  BALANCED  // |input - (output+waste+remaining)| ≤ tolerance (0.5%)
  WARNING   // Difference 0.5%–5%, explanation required
  BLOCKED   // Difference >5% or unexplained — lot cannot be released
}

/// Quality workflow status for Inspections.
/// Note: APPROVED is an internal workflow status, NOT an automated food-safety certification (BR-010).
enum QualityStatus {
  PENDING
  INSPECTED
  APPROVED
  HOLD
}

/// Visibility level for Evidence documents (§55).
enum VisibilityLevel {
  INTERNAL
  BUYER
  PUBLIC
}

// ─────────────────────────────────────────────────────────────────────────────
// Tenant Root
// ─────────────────────────────────────────────────────────────────────────────

model Organization {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sites         Site[]
  users         User[]
  lots          Lot[]
  suppliers     Supplier[]
  buyers        Buyer[]
  processEvents ProcessEvent[]
  auditLogs     AuditLog[]
  inspections   Inspection[]
  evidences     Evidence[]
  packages      Package[]
  shipments     Shipment[]
  complaints    Complaint[]
  gateways      Gateway[]
  sensors       Sensor[]
  exportJobs    ExportJob[]
}

// ─────────────────────────────────────────────────────────────────────────────
// Physical Hierarchy
// ─────────────────────────────────────────────────────────────────────────────

model Site {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  address        String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization  @relation(fields: [organizationId], references: [id])
  locations      Location[]
  lots           Lot[]
  processEvents  ProcessEvent[]
  gateways       Gateway[]
  sensors        Sensor[]
}

model Location {
  id        String         @id @default(uuid())
  siteId    String
  name      String
  type      String         // WAREHOUSE | PROCESSING | LAB | FIELD
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  site          Site           @relation(fields: [siteId], references: [id])
  lots          Lot[]
  processEvents ProcessEvent[]
  sensors       Sensor[]
}

// ─────────────────────────────────────────────────────────────────────────────
// Master Data: Supplier & Buyer
// ─────────────────────────────────────────────────────────────────────────────

model Supplier {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  code           String?
  contactName    String?
  contactEmail   String?
  contactPhone   String?
  address        String?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id])
  lots           Lot[]        @relation("SupplierLots")

  @@unique([organizationId, code])
  @@index([organizationId, isActive])
}

model Buyer {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  code           String?
  contactName    String?
  contactEmail   String?
  contactPhone   String?
  address        String?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id])
  shipments      Shipment[]

  @@unique([organizationId, code])
  @@index([organizationId, isActive])
}

// ─────────────────────────────────────────────────────────────────────────────
// User
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id             String        @id @default(uuid())
  organizationId String?
  email          String        @unique
  passwordHash   String
  name           String
  role           Role
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization   Organization? @relation(fields: [organizationId], references: [id])
  auditLogs      AuditLog[]    @relation("UserAuditLogs")
  lotsCreated    Lot[]         @relation("LotCreatedBy")
  lotsReleased   Lot[]         @relation("LotReleasedBy")
  lotEvents      LotEvent[]    @relation("LotEventActor")
  processEvents  ProcessEvent[] @relation("ProcessEventCreatedBy")
  refreshTokens  RefreshToken[]
  inspections    Inspection[]  @relation("InspectorUser")
  evidences      Evidence[]    @relation("EvidenceUploader")
  qrActivations  QrSerial[]    @relation("QrActivatedBy")
  complaints     Complaint[]   @relation("ComplaintResponsibleUser")
  shipmentsCreated Shipment[]  @relation("ShipmentCreatedBy")
  exportJobs     ExportJob[]   @relation("ExportJobRequestedBy")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Lot Domain (§42–43)
// ─────────────────────────────────────────────────────────────────────────────

model Lot {
  id             String      @id @default(uuid())
  organizationId String
  lotCode        String      // Human-readable code within org
  lotType        LotType     @default(RECEIVED)
  productName    String
  quantity       Decimal     @db.Decimal(12, 3)
  unit           String
  status         LotStatus   @default(DRAFT)
  siteId         String?
  locationId     String?
  supplierId     String?     // Set for RECEIVED lots
  createdById    String?
  releasedAt     DateTime?
  releasedById   String?
  description    String?
  evidenceUrls   Json?       // String[] — photo/doc references
  metadata       Json?
  deletedAt      DateTime?

  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id])
  site           Site?        @relation(fields: [siteId], references: [id])
  location       Location?    @relation(fields: [locationId], references: [id])
  supplier       Supplier?    @relation("SupplierLots", fields: [supplierId], references: [id])
  createdBy      User?        @relation("LotCreatedBy", fields: [createdById], references: [id])
  releasedBy     User?        @relation("LotReleasedBy", fields: [releasedById], references: [id])

  // Lineage — a lot can be source (contributed to others) or target (produced from others)
  asSource       LotRelation[] @relation("SourceLot")
  asTarget       LotRelation[] @relation("TargetLot")

  // Process event participation
  processInputs  ProcessEventInput[]
  processOutputs ProcessEventOutput[]

  events         LotEvent[]
  auditLogs      AuditLog[]
  inspections    Inspection[]
  evidences      Evidence[]
  packages       Package[]
  shipmentLines  ShipmentLine[]
  complaints     Complaint[]

  @@unique([organizationId, lotCode])
  @@index([organizationId, status])
  @@index([organizationId, lotType])
  @@index([organizationId, supplierId])
  @@index([organizationId, deletedAt])
}

/// Directed lineage edge between lots (§43).
/// Many-to-many: one source can contribute to many targets; one target can have many sources.
/// NEVER replace with a single parent_id — that cannot represent Mix (many→1) or Split (1→many).
model LotRelation {
  id           String       @id @default(uuid())
  organizationId String     // Denormalized for fast tenant-scoped queries
  sourceLotId  String       // The lot that was CONSUMED / INPUT
  targetLotId  String       // The lot that was PRODUCED / OUTPUT
  relationType RelationType
  quantity     Decimal      @db.Decimal(12, 3)
  unit         String
  eventId      String?      // ProcessEvent that created this relation
  createdAt    DateTime     @default(now())

  sourceLot    Lot          @relation("SourceLot", fields: [sourceLotId], references: [id])
  targetLot    Lot          @relation("TargetLot", fields: [targetLotId], references: [id])
  event        ProcessEvent? @relation(fields: [eventId], references: [id])

  @@unique([sourceLotId, targetLotId, relationType])
  @@index([organizationId, sourceLotId])
  @@index([organizationId, targetLotId])
  @@index([eventId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Process Event (§44)
// ─────────────────────────────────────────────────────────────────────────────

model ProcessEvent {
  id                 String             @id @default(uuid())
  organizationId     String
  eventCode          String             // Human-readable: PE-2024-001
  eventType          ProcessEventType
  customEventName    String?            // Used when eventType = CUSTOM
  siteId             String?
  locationId         String?
  startAt            DateTime
  endAt              DateTime?
  createdById        String?
  notes              String?
  evidenceUrls       Json?              // String[]
  massBalanceStatus  MassBalanceStatus  @default(BALANCED)
  massBalanceDiff    Decimal?           @db.Decimal(12, 3)  // input - (output+waste+remaining)
  massBalanceNote    String?            // Required explanation if WARNING/BLOCKED
  deletedAt          DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  organization  Organization         @relation(fields: [organizationId], references: [id])
  site          Site?                @relation(fields: [siteId], references: [id])
  location      Location?            @relation(fields: [locationId], references: [id])
  createdBy     User?                @relation("ProcessEventCreatedBy", fields: [createdById], references: [id])

  inputs        ProcessEventInput[]
  outputs       ProcessEventOutput[]
  lotRelations  LotRelation[]        // Relations created by this event
  evidences     Evidence[]

  @@unique([organizationId, eventCode])
  @@index([organizationId, eventType])
  @@index([organizationId, massBalanceStatus])
  @@index([organizationId, deletedAt])
}

/// Each input lot consumed by a process event.
model ProcessEventInput {
  id        String       @id @default(uuid())
  eventId   String
  lotId     String
  quantity  Decimal      @db.Decimal(12, 3)
  unit      String

  event     ProcessEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  lot       Lot          @relation(fields: [lotId], references: [id])

  @@unique([eventId, lotId])
}

/// Each output lot produced by a process event, with waste and remaining.
model ProcessEventOutput {
  id          String       @id @default(uuid())
  eventId     String
  lotId       String
  quantity    Decimal      @db.Decimal(12, 3)
  unit        String
  waste       Decimal      @db.Decimal(12, 3) @default(0)
  remaining   Decimal      @db.Decimal(12, 3) @default(0)

  event       ProcessEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  lot         Lot          @relation(fields: [lotId], references: [id])

  @@unique([eventId, lotId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Lot Event — append-only audit trail per lot
// ─────────────────────────────────────────────────────────────────────────────

model LotEvent {
  id         String    @id @default(uuid())
  lotId      String
  actorId    String?
  eventType  String    // STATUS_CHANGED | LOT_CREATED | LOT_UPDATED | EVIDENCE_ADDED …
  payload    Json?
  note       String?
  occurredAt DateTime  @default(now())

  lot        Lot       @relation(fields: [lotId], references: [id])
  actor      User?     @relation("LotEventActor", fields: [actorId], references: [id])

  @@index([lotId, occurredAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Audit Log (org-wide)
// ─────────────────────────────────────────────────────────────────────────────

model AuditLog {
  id             String       @id @default(uuid())
  organizationId String
  actorId        String?
  action         String
  entity         String
  entityId       String
  lotId          String?
  oldValue       Json?
  newValue       Json?
  reason         String?
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id])
  actor          User?        @relation("UserAuditLogs", fields: [actorId], references: [id])
  lot            Lot?         @relation(fields: [lotId], references: [id])
}

// ─────────────────────────────────────────────────────────────────────────────
// Quality & Release (§16, §34, §55)
// ─────────────────────────────────────────────────────────────────────────────

model Inspection {
  id                      String        @id @default(uuid())
  organizationId          String
  lotId                   String
  sampleId                String?
  testMethod              String
  date                    DateTime      @default(now())
  result                  String
  specificationReference  String?
  inspectorId             String?
  notes                   String?
  status                  QualityStatus @default(PENDING)
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  lot          Lot          @relation(fields: [lotId], references: [id], onDelete: Cascade)
  inspector    User?        @relation("InspectorUser", fields: [inspectorId], references: [id])
  evidences    Evidence[]

  @@index([organizationId, status])
  @@index([lotId])
}

model Evidence {
  id             String          @id @default(uuid())
  organizationId String
  fileName       String
  documentUrl    String          // The actual S3/storage path
  documentType   String          // PDF, JPG, PNG, CSV
  visibility     VisibilityLevel @default(INTERNAL)
  uploadedById   String?
  
  // Linked objects
  lotId          String?
  processEventId String?
  inspectionId   String?
  
  createdAt      DateTime        @default(now())

  organization   Organization  @relation(fields: [organizationId], references: [id])
  uploadedBy     User?         @relation("EvidenceUploader", fields: [uploadedById], references: [id])
  lot            Lot?          @relation(fields: [lotId], references: [id])
  processEvent   ProcessEvent? @relation(fields: [processEventId], references: [id])
  inspection     Inspection?   @relation(fields: [inspectionId], references: [id])

  @@index([organizationId, visibility])
  @@index([lotId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Packaging & QR (§45-46, §17-18)
// ─────────────────────────────────────────────────────────────────────────────

enum PackageStatus {
  CREATED
  LABELED
  QR_PENDING
  ACTIVE
  SHIPPED
}

enum QrStatus {
  GENERATED
  PENDING_ACTIVATION
  ACTIVE
  REPLACED
  VOID
  BLOCKED
}

enum QrAnomalyStatus {
  NORMAL
  UNUSUAL_SCAN_PATTERN
  BLOCKED_SERIAL
  REPLACED_LABEL
  UNKNOWN_STATUS
}

model Package {
  id             String        @id @default(uuid())
  organizationId String
  packageCode    String
  lotId          String
  packageSize    Float
  quantity       Int
  unit           String
  status         PackageStatus @default(CREATED)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization   Organization  @relation(fields: [organizationId], references: [id])
  lot            Lot           @relation(fields: [lotId], references: [id])
  qrSerials      QrSerial[]
  complaints     Complaint[]

  @@unique([organizationId, packageCode])
  @@index([lotId])
}

model QrSerial {
  id             String          @id @default(uuid())
  serial         String          @unique // Truly global unique identifier
  packageId      String
  status         QrStatus        @default(GENERATED)
  anomalyStatus  QrAnomalyStatus @default(NORMAL)
  
  activatedAt    DateTime?
  activatedById  String?
  replacementOf  String?         // ID of the old QrSerial if replaced

  createdAt      DateTime        @default(now())
  updatedAt      DateTime      @updatedAt

  package        Package         @relation(fields: [packageId], references: [id])
  activatedBy    User?           @relation("QrActivatedBy", fields: [activatedById], references: [id])

  @@index([packageId])
  @@index([status])
}

// ─────────────────────────────────────────────────────────────────────────────
// Distribution & Shipments (§47, §21)
// ─────────────────────────────────────────────────────────────────────────────

enum ShipmentStatus {
  PLANNED
  SHIPPED
  DELIVERED
  CANCELLED
}

model Shipment {
  id                String         @id @default(uuid())
  organizationId    String
  shipmentCode      String
  buyerId           String
  shipmentDate      DateTime
  status            ShipmentStatus @default(PLANNED)
  proofOfDelivery   String?        // Link to evidence document
  createdById       String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  organization      Organization   @relation(fields: [organizationId], references: [id])
  buyer             Buyer          @relation(fields: [buyerId], references: [id])
  createdBy         User?          @relation("ShipmentCreatedBy", fields: [createdById], references: [id])
  lines             ShipmentLine[]

  @@unique([organizationId, shipmentCode])
  @@index([buyerId])
}

model ShipmentLine {
  id           String   @id @default(uuid())
  shipmentId   String
  lotId        String
  packageCount Int?
  quantity     Decimal  @db.Decimal(12, 3)
  unit         String

  shipment     Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  lot          Lot      @relation(fields: [lotId], references: [id])
}

// ─────────────────────────────────────────────────────────────────────────────
// Complaints & Investigation (§48, §24)
// ─────────────────────────────────────────────────────────────────────────────

enum ComplaintStatus {
  OPEN
  INVESTIGATING
  ACTION_REQUIRED
  RESOLVED
  CLOSED
}

model Complaint {
  id                 String          @id @default(uuid())
  organizationId     String
  caseCode           String
  reportedBy         String
  relatedLotId       String?
  relatedPackageId   String?
  reason             String
  description        String
  status             ComplaintStatus @default(OPEN)
  responsibleUserId  String?
  closedAt           DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  
  // Stores the generated impact scope as a JSON snapshot (§24.2, §81)
  impactScope        Json?           

  organization       Organization    @relation(fields: [organizationId], references: [id])
  relatedLot         Lot?            @relation(fields: [relatedLotId], references: [id])
  relatedPackage     Package?        @relation(fields: [relatedPackageId], references: [id])
  responsibleUser    User?           @relation("ComplaintResponsibleUser", fields: [responsibleUserId], references: [id])

  @@unique([organizationId, caseCode])
  @@index([organizationId, status])
}

// ─────────────────────────────────────────────────────────────────────────────
// IoT & Environment (§29, §49)
// ─────────────────────────────────────────────────────────────────────────────

enum SensorState {
  ONLINE
  OFFLINE
  MISSING_DATA
  OUT_OF_RANGE
  UNVERIFIED
}

enum ReadingQuality {
  NORMAL
  MISSING
  OFFLINE
  OUT_OF_RANGE
  UNVERIFIED
}

model Gateway {
  id             String       @id @default(uuid())
  organizationId String
  deviceCode     String
  siteId         String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id])
  site           Site         @relation(fields: [siteId], references: [id])
  sensors        Sensor[]

  @@unique([organizationId, deviceCode])
}

model Sensor {
  id                 String       @id @default(uuid())
  organizationId     String
  deviceCode         String
  model              String?
  siteId             String?
  locationId         String?
  gatewayId          String?
  status             SensorState  @default(UNVERIFIED)
  lastSeenAt         DateTime?
  verificationStatus String?      // For MVP: Verified/Unverified text
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  site         Site?        @relation(fields: [siteId], references: [id])
  location     Location?    @relation(fields: [locationId], references: [id])
  gateway      Gateway?     @relation(fields: [gatewayId], references: [id])
  readings     SensorReading[]

  @@unique([organizationId, deviceCode])
  @@index([locationId])
}

model SensorReading {
  id               String         @id @default(uuid())
  sensorId         String
  timestamp        DateTime       @default(now())
  temperature      Decimal?       @db.Decimal(5, 2)
  relativeHumidity Decimal?       @db.Decimal(5, 2)
  dataQuality      ReadingQuality @default(NORMAL)

  sensor           Sensor         @relation(fields: [sensorId], references: [id], onDelete: Cascade)

  // Critical index for time-series extraction
  @@index([sensorId, timestamp])
}

// ─────────────────────────────────────────────────────────────────────────────
// Reporting & Async Exports (§39, §63)
// ─────────────────────────────────────────────────────────────────────────────

enum ExportJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model ExportJob {
  id             String          @id @default(uuid())
  organizationId String
  requestedById  String
  reportType     String          // TRACEABILITY | MASS_BALANCE | COMPLAINT | ENVIRONMENTAL
  filters        Json            // Store applied filters
  format         String          // CSV | PDF
  status         ExportJobStatus @default(PENDING)
  fileUrl        String?         // URL once generated
  errorMessage   String?
  createdAt      DateTime        @default(now())
  completedAt    DateTime?

  organization   Organization    @relation(fields: [organizationId], references: [id])
  requestedBy    User            @relation("ExportJobRequestedBy", fields: [requestedById], references: [id])

  @@index([organizationId, status])
}





